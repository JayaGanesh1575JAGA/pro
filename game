
def print_board(board):
    print("\n" + " " + board[0] + " | " + board[1] + " | " + board[2])
    print("---+---+---")
    print(" " + board[3] + " | " + board[4] + " | " + board[5])
    print("---+---+---")
    print(" " + board[6] + " | " + board[7] + " | " + board[8] + "\n")


def check_winner(board, player):
    winning_lines = [
        [0, 1, 2],
        [3, 4, 5],
        [6, 7, 8],
        [0, 3, 6],
        [1, 4, 7],
        [2, 5, 8],
        [0, 4, 8],
        [2, 4, 6],
    ]

    for line in winning_lines:
        if board[line[0]] == player and board[line[1]] == player and board[line[2]] == player:
            return True
    return False


def play_game():
    board = [" "] * 9
    current_player = "X"

    print("\n===== WELCOME TO TIC-TAC-TOE =====")
    print("Select a position from 1 to 9.")

    while True:
        print_board(board)

        try:
            choice = int(input(f"Player {current_player}, choose a position (1-9): "))
        except ValueError:
            print("Please enter a valid numeric value.")
            continue

        if choice < 1 or choice > 9:
            print("Invalid selection. Please choose a number between 1 and 9.")
            continue

        if board[choice - 1] != " ":
            print("That position is already occupied. Please choose another one.")
            continue

        board[choice - 1] = current_player

        if check_winner(board, current_player):
            print_board(board)
            print(f"Congratulations! Player {current_player} wins!")
            return

        if " " not in board:
            print_board(board)
            print("The game ends in a draw.")
            return

        current_player = "O" if current_player == "X" else "X"


def main():
    while True:
        play_game()
        again = input("Would you like to play again? (yes/no): ").strip().lower()

        if again not in {"yes", "y"}:
            print("Thank you for playing Tic-Tac-Toe. Goodbye!")
            break


if __name__ == "__main__":
    main()
